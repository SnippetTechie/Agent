# Copy this file to server/.env and fill in real values for your machine.
# server/.env is gitignored — nothing here should ever be committed.

RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=8002

# vLLM OpenAI-compatible endpoint serving UI-TARS (local, tunnel, or LAN).
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=UI-TARS-7B

# Shown to the user only when the vLLM server/tunnel is unreachable.
SSH_TUNNEL_HINT=ssh -p <port> -L 8000:localhost:8000 <user>@<host>
