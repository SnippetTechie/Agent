# V.A.R.M.A receiver — production & local configuration
#
# Copy this file to server/.env:
#   cp server/.env.example server/.env

# --- Receiver Network Binding ---------------------------------------------
# Use 0.0.0.0 so external clients / Chrome extensions can reach the server.
# Use 127.0.0.1 only if running locally on the same laptop.
RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=8002

# --- Model Provider (vLLM with gemma-4-12b-it) -----------------------------
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=gemma-4-12b-it
MODELS=gemma-4-12b-it
MODEL_VISION=gemma-4-12b-it
GROUNDING_BASE_URL=http://127.0.0.1:8000/v1
GROUNDING_MODEL=gemma-4-12b-it
GROUNDING_ENABLED=1
VLLM_MAX_TOKENS=512

# --- Optional Cloud Fallback (Google Gemini API) ---------------------------
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase Cloud (Database, Isolated Storage & Google Auth) ------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_STORAGE_BUCKET=redacted-screens

# --- Browser & Agent loop -------------------------------------------------
CDP_URL=http://localhost:9222
AGENT_MAX_STEPS=15
AGENT_MAX_ACTIONS_PER_STEP=3
GAME_MAX_STEPS=60

