# V.A.R.M.A receiver — local overrides template
#
# The receiver reads PROCESS ENVIRONMENT VARIABLES. It does not auto-load this
# file. Copy the values you need into your shell, or export them before running
# `python scripts/start_server.py`.
#
# PowerShell:
#   $env:VLLM_MODEL = "gemma-3"; python scripts/start_server.py
# bash:
#   export VLLM_MODEL=gemma-3; python scripts/start_server.py

# --- Receiver -------------------------------------------------------------
RECEIVER_HOST=127.0.0.1
RECEIVER_PORT=8002

# --- Model (vLLM, OpenAI-compatible) --------------------------------------
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=gemma-3
# VLLM_MAX_TOKENS=512

# --- Browser (Chrome DevTools Protocol) -----------------------------------
CDP_URL=http://localhost:9222

# --- Agent loop -----------------------------------------------------------
# AGENT_MAX_STEPS=15
# AGENT_MAX_ACTIONS_PER_STEP=3
# AGENT_SHOW_OVERLAY=1
# AGENT_SHOW_CURSOR=1

# --- Remote GPU box hint (informational only, not read by the code) -------
# SSH_TUNNEL_HINT=ssh -L 8000:localhost:8000 <user>@<gpu-host>
